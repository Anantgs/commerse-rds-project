[Unit]
Description=Commerce Flask application
After=network.target

[Service]
User=root
Group=root
WorkingDirectory=__APP_DIR__
EnvironmentFile=__APP_DIR__/.env
ExecStart=__APP_DIR__/.venv/bin/gunicorn --workers 2 --bind 127.0.0.1:8000 'app:app'
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
